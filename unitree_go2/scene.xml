<mujoco model="go2 scene">
  <include file="go2.xml"/>

  <visual>
    <headlight diffuse="0.7 0.7 0.65" ambient="0.35 0.35 0.4" specular="0.3 0.3 0.3"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.35 0.55 0.8" rgb2="0.85 0.9 1.0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" rgb1="0.28 0.38 0.2" rgb2="0.35 0.42 0.25" width="512" height="512"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="10 10" reflectance="0.05"/>

    <!-- Taste zones: glowing floor patches (match LoomingArena) -->
    <material name="taste_sugar" rgba="0.15 0.75 0.15 0.5" emission="0.3" reflectance="0.15"/>
    <material name="taste_bitter" rgba="0.75 0.12 0.12 0.5" emission="0.3" reflectance="0.15"/>
    <!-- Odor sources: glowing spheres + translucent halos -->
    <material name="odor_att_core" rgba="0.2 0.85 0.3 0.7" emission="0.5"/>
    <material name="odor_att_halo" rgba="0.2 0.85 0.3 0.15" emission="0.8"/>
    <material name="odor_rep_core" rgba="0.85 0.2 0.85 0.7" emission="0.5"/>
    <material name="odor_rep_halo" rgba="0.85 0.2 0.85 0.15" emission="0.8"/>
  </asset>

  <worldbody>
    <light name="sun" pos="0 0 15" dir="0.4 0.3 -1" diffuse="1.0 0.95 0.85" specular="0.5 0.5 0.4" castshadow="true" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Visual-object placeholders (positioned dynamically by Go2Sim.place_*) -->
    <geom name="taste_zone_0" type="cylinder" size="0.01 0.02" pos="0 0 -10" material="taste_sugar" contype="0" conaffinity="0"/>
    <geom name="taste_zone_1" type="cylinder" size="0.01 0.02" pos="0 0 -10" material="taste_bitter" contype="0" conaffinity="0"/>
    <geom name="odor_core_0" type="sphere" size="0.3" pos="0 0 -10" material="odor_att_core" contype="0" conaffinity="0"/>
    <geom name="odor_halo_0" type="sphere" size="0.8" pos="0 0 -10" material="odor_att_halo" contype="0" conaffinity="0"/>
    <geom name="odor_core_1" type="sphere" size="0.3" pos="0 0 -10" material="odor_rep_core" contype="0" conaffinity="0"/>
    <geom name="odor_halo_1" type="sphere" size="0.8" pos="0 0 -10" material="odor_rep_halo" contype="0" conaffinity="0"/>

    <body name="looming_ball" pos="4.0 0 0.3">
      <freejoint name="looming_ball_joint"/>
      <geom name="looming_ball_geom" type="sphere" size="0.15" rgba="0.05 0.05 0.08 1"/>
    </body>
  </worldbody>
</mujoco>